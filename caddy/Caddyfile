# eAFYA Assistant reverse proxy.
#
# Caddy only forwards traffic (and provides HTTPS once there is a hostname).
# Logins are handled by the app itself: one account per person, managed by
# super users at /admin (app/auth.py, app/ui/admin.py).

:8000 {
	# Health check endpoint so docker-compose can probe it.
	@health path /healthz
	respond @health "ok" 200

	reverse_proxy app:8000 {
		# Drop idle connections to the app before the app does (it closes them
		# after 5 s). Otherwise a form sent at that instant, such as a login,
		# fails with a 502: Caddy cannot safely retry a POST.
		transport http {
			keepalive 2s
		}
		# Chainlit uses websockets for streaming.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
