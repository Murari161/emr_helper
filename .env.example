# --- Database ----------------------------------------------------------------
# In docker-compose the hostname is the service name (db). For native dev,
# point this at your local Postgres (e.g. postgresql://emr:emr@localhost:5432/emr_helper).
#
# Note: this env var is deliberately APP_DATABASE_URL, not DATABASE_URL.
# Chainlit 2.x auto-detects `DATABASE_URL` and tries to initialise its
# bundled SQLAlchemy data layer against it (Thread/Step/User tables), which
# does not match our schema. We hide our DSN under a different name so
# Chainlit can't see it.
APP_DATABASE_URL=postgresql://emr:emr@db:5432/emr_helper

# --- Ollama ------------------------------------------------------------------
# Same pattern: 'ollama' inside docker-compose; 'localhost' for native dev.
OLLAMA_BASE_URL=http://ollama:11434

# Embedding model. bge-m3 produces 1024-dim vectors. Must match EMBEDDING_DIM
# and the vector column type in app/db/schema.sql.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Generation model. Uncomment EXACTLY ONE of the lines below — the last one
# Bash sees wins, so leaving multiple uncommented is the same as picking the
# last one (and will confuse future-you).
#
# Pull each model once before using:
#     docker compose exec ollama ollama pull <name>
#
# CPU-friendly (hospital server target):
GENERATION_MODEL=llama3.2:3b           # 2.0 GB — current default, ~15 s/answer on CPU
# GENERATION_MODEL=llama3.2:1b         # 1.3 GB — fastest, simpler reasoning; ~5 s on CPU
# GENERATION_MODEL=qwen2.5:3b          # 2.0 GB — same size as llama3.2:3b, sometimes tighter instruction following
#
# Bigger, needs GPU to be usable (dev laptop with RTX/A-series):
# GENERATION_MODEL=llama3.1:latest     # 4.7 GB (8B) — ~5-8 s on GPU, ~90 s on CPU
# GENERATION_MODEL=qwen2.5:7b          # 4.7 GB (7B) — same speed class as llama3.1:8b
#
# These will NOT run on a single 8 GB GPU. Listed for completeness; pulling
# them costs ~40-70 GB of disk and they'll OOM at inference time.
# GENERATION_MODEL=llama3.3:latest     # 40 GB (70B) — needs 35+ GB VRAM
# GENERATION_MODEL=llama4:latest       # 67 GB (109B MoE Scout) — multi-GPU territory

# Hosted answer model, for the online server only (app/rag/llm.py). Laptops
# and facilities leave these out and use the local model above. Search stays
# local either way. The key goes in the server's .env only, never in git.
# GENERATION_PROVIDER=openai
# GENERATION_API_BASE=https://api.together.xyz/v1
# GENERATION_API_KEY=
# GENERATION_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo

# Reranker. Used by app/rag/reranker.py to score the top-20 fused candidates.
RERANKER_MODEL=bge-reranker-v2-m3
# Set to false on a CPU-only / 8 GB machine: skips the reranker, saving ~2 GB
# of RAM and ~13 s per answer for a small loss in ranking accuracy.
# RERANKER_ENABLED=false

# How strongly a question must match the manuals before it is answered from
# them. Below both thresholds it gets a fixed "off-topic" or "contact your
# eAFYA Focal Person" reply instead (app/rag/fallback.py). Defaults shown.
# MATCH_STRONG_VECTOR=0.60
# MATCH_STRONG_BM25=0.75

# --- Logins ------------------------------------------------------------------
# Signs the login cookie; the app will not start without it. Generate a random
# string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
# Changing it logs everybody out.
CHAINLIT_AUTH_SECRET=

# Accounts are created by super users at /admin (the first one with
# `python -m scripts.users add <username> --role super_user`, see SETUP.md).
# Ordinary users get no answers from these manuals (exact manual titles,
# comma-separated). Defaults shown.
# RESTRICTED_MODULES=Human Resources Management Module,User and Facility Management Module
# A question counts as being about a restricted task only if its best match
# there beats the best match in the open manuals by at least this much.
# RESTRICTED_GAP=0.03

# Facility installation: normal users use the assistant without logging in;
# only super users log in, at /account/login. Only while the computer cannot
# be reached from the internet. Leave it out (true) on the online server.
# LOGIN_REQUIRED=false

# --- Online server only (askeafya.com), see SETUP.md --------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# DOMAIN=askeafya.com
# Optional: more domains that forward to DOMAIN, separated by spaces.
# OTHER_DOMAINS=askeafya.chat www.askeafya.chat

# --- App ---------------------------------------------------------------------
APP_LOG_LEVEL=INFO

# In-container path. The host path is bound to this via docker-compose volumes,
# so code should only ever reference DATA_DIR — never a host-specific path.
DATA_DIR=/data

# URL prefix Chainlit uses when serving extracted screenshots back to the browser.
IMAGES_URL_PREFIX=/images
