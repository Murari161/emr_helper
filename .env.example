# --- Database ----------------------------------------------------------------
# In docker-compose the hostname is the service name (db). For native dev,
# point this at your local Postgres (e.g. postgresql://emr:emr@localhost:5432/emr_helper).
#
# Note: this env var is deliberately APP_DATABASE_URL, not DATABASE_URL.
# Chainlit 2.x auto-detects `DATABASE_URL` and tries to initialise its
# bundled SQLAlchemy data layer against it (Thread/Step/User tables), which
# does not match our schema. We hide our DSN under a different name so
# Chainlit can't see it.
APP_DATABASE_URL=postgresql://emr:emr@db:5432/emr_helper

# --- Ollama ------------------------------------------------------------------
# Same pattern: 'ollama' inside docker-compose; 'localhost' for native dev.
OLLAMA_BASE_URL=http://ollama:11434

# Embedding model. bge-m3 produces 1024-dim vectors. Must match EMBEDDING_DIM
# and the vector column type in app/db/schema.sql.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Generation model. llama3.2:3b is the CPU-friendly default (~30-80 ms/token).
# Upgrade path for GPU hosts: qwen3:8b or llama3.3:8b.
GENERATION_MODEL=llama3.2:3b

# Reranker. Used by app/rag/reranker.py to score the top-20 fused candidates.
RERANKER_MODEL=bge-reranker-v2-m3

# --- Chainlit ----------------------------------------------------------------
# Required by Chainlit even though we don't use its built-in auth. Generate a
# random string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
CHAINLIT_AUTH_SECRET=

# --- Caddy basic auth --------------------------------------------------------
# Bcrypt hash of the basic-auth password. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "yourpassword"
#
# IMPORTANT: bcrypt hashes contain `$` signs that docker-compose interprets
# as variable references. You MUST escape each `$` as `$$` here, otherwise
# parts of the hash get expanded to empty string and login silently fails.
#
# Example — if `caddy hash-password` prints:
#     $2a$14$LQWQl288r.4C5m0vuXv3quzL3DoqMAFthN4AuBq/ZtV9CNhDplJwu
# you must store it here as:
#     BASIC_AUTH_HASH=$$2a$$14$$LQWQl288r.4C5m0vuXv3quzL3DoqMAFthN4AuBq/ZtV9CNhDplJwu
# (every `$` doubled, no surrounding quotes)
#
# To rotate the password: regenerate, replace the value (still $$-escaped),
# then `docker compose up -d` (recreates caddy with the new env).
BASIC_AUTH_HASH=

# --- App ---------------------------------------------------------------------
APP_LOG_LEVEL=INFO

# In-container path. The host path is bound to this via docker-compose volumes,
# so code should only ever reference DATA_DIR — never a host-specific path.
DATA_DIR=/data

# URL prefix Chainlit uses when serving extracted screenshots back to the browser.
IMAGES_URL_PREFIX=/images
